{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["scripts/dependency-score-policy.ts"],
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test --isolate scripts/dependency-score.test.ts"
  },
  "coverageAnalysis": "off",
  "concurrency": 4,
  "reporters": ["clear-text", "progress"],
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codegraph/**",
    ".direnv/**",
    ".stryker-tmp/**",
    "coverage/**",
    "prototype/**",
    "result",
    "result-*/**"
  ]
}

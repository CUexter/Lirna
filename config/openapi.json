    "/sep-admission/preview/{previewId}/admit": {
      "post": {
        "operationId": "sepAdmission.admit",
        "summary": "Admit a preview with observations",
        "tags": ["SEP Admission"],
        "parameters": [
          {
            "in": "path",
            "required": true,
            "name": "previewId",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "observationKeys": {
                    "minItems": 1,
                    "maxItems": 2,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["submitted", "recommended-archive"]
                    }
                  }
                },
                "required": ["observationKeys"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {}
          }
        }
      }
    },

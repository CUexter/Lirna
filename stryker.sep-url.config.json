{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["packages/api/src/sep-admission/sep-url.ts"],
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test --isolate packages/api/src/sep-admission/sep-capture.test.ts"

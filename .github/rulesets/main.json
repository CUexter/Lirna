{
  "name": "main security gates",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          { "context": "Gitleaks" },
          { "context": "Dependency verification" },
          { "context": "Semgrep" },
          { "context": "Trivy npm vulnerability policy" }
        ]
      }
    }
  ],
  "bypass_actors": []
}

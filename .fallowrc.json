{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.nx/**",
    "**/dev-dist/**",
    "**/src-tauri/**",
    "**/.wrangler/**",
    "**/.alchemy/**",
    "prototype/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "result/**",
    "result-*",
    "scripts/assess-dependency.mjs",
    "scripts/check-architecture.mjs",
    "scripts/check-react-props.mjs",
    "scripts/check-documentation.mjs",
    "scripts/check-architecture.test.mjs",
    "scripts/check-coverage.test.mjs",
    "scripts/check-documentation.test.mjs",
    "scripts/normalize-istanbul-coverage.mjs",
    "scripts/web-bundle-budget.test.mjs",
    "apps/web/pwa-assets.config.ts",
    "config/semgrep/fixtures/**"
  ],
  "rules": {
    "circular-dependencies": "error",
    "boundary-violation": "error",
    "unlisted-dependencies": "error",
    "unresolved-imports": "error",
    "duplicate-exports": "error",
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "unused-enum-members": "warn",
    "unused-class-members": "warn",
    "unresolved-catalog-references": "warn",
    "misconfigured-dependency-overrides": "warn",
    "route-collision": "off",
    "dynamic-segment-name-conflict": "off"
  },
  "boundaries": {
    "zones": [
      { "name": "web", "patterns": ["apps/web/**"] },
      { "name": "server", "patterns": ["apps/server/**"] },
      { "name": "docs", "patterns": ["apps/docs/**"] },
      { "name": "ui", "patterns": ["packages/ui/**"] },
      { "name": "env", "patterns": ["packages/env/**"] },
      { "name": "db", "patterns": ["packages/db/**"] },
      { "name": "auth", "patterns": ["packages/auth/**"] },
      { "name": "api", "patterns": ["packages/api/**"] },
      { "name": "config", "patterns": ["packages/config/**"] }
    ],
    "rules": [
      { "from": "web", "allow": ["api", "env", "ui"] },
      { "from": "server", "allow": ["api", "auth", "db", "env"] },
      { "from": "docs", "allow": [] },
      { "from": "ui", "allow": [] },
      { "from": "env", "allow": [] },
      { "from": "db", "allow": ["env"] },
      { "from": "auth", "allow": ["db", "env"] },
      { "from": "api", "allow": ["auth", "db", "env"] },
      { "from": "config", "allow": [] }
    ],
    "coverage": {
      "requireAllFiles": false,
      "allowUnmatched": [
        "scripts/**",
        "config/**",
        "*.json",
        "*.jsonc",
        "*.mjs"
      ]
    }
  },
  "duplicates": {
    "mode": "strict",
    "ignore": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "packages/db/src/schema/sep-admission.ts",
      "packages/db/src/schema/sources.ts"
    ]
  },
  "health": {
    "maxCognitive": 15,
    "maxCyclomatic": 20,
    "maxCrap": 0
  }
}

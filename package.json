{
  "name": "lirna",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts/lifecycle"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.12.32",
      "@orpc/server": "2.0.0-beta.28",
      "@orpc/client": "2.0.0-beta.28",
      "@orpc/tanstack-query": "2.0.0-beta.28",
      "@orpc/openapi": "2.0.0-beta.28",
      "@orpc/zod": "2.0.0-beta.28",
      "@scalar/hono-api-reference": "^0.11.14",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "pino": "^9.7.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "imports": {
    "#path-safety": "./scripts/path-safety.ts"
  },
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "lifecycle": "bun scripts/lifecycle.ts",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "test": "VITE_SERVER_URL=http://127.0.0.1:3000 bun test --isolate --preload ./happydom.ts",
    "test:coverage": "VITE_SERVER_URL=http://127.0.0.1:3000 bun test --isolate --coverage --preload ./happydom.ts && bun scripts/check-coverage.ts",
    "test:mutation": "bun run --parallel 'test:mutation:*'",
    "test:mutation:api-sep-reading": "MUTATION_SHARD=api-sep-reading stryker run stryker.application.config.mjs",
    "test:mutation:api-sep-capture": "MUTATION_SHARD=api-sep-capture stryker run stryker.application.config.mjs",
    "test:mutation:api-core": "MUTATION_SHARD=api-core stryker run stryker.application.config.mjs",
    "test:mutation:web-annotations": "MUTATION_SHARD=web-annotations stryker run stryker.application.config.mjs",
    "test:mutation:web-reading": "MUTATION_SHARD=web-reading stryker run stryker.application.config.mjs",
    "test:mutation:web-source": "MUTATION_SHARD=web-source stryker run stryker.application.config.mjs",
    "test:mutation:web-app": "MUTATION_SHARD=web-app stryker run stryker.application.config.mjs",
    "test:mutation:platform": "MUTATION_SHARD=platform stryker run stryker.application.config.mjs",
    "test:web": "VITE_SERVER_URL=http://127.0.0.1:3000 bun test --isolate --no-env-file --preload ./happydom.ts apps/web packages/ui",
    "coverage:baseline": "bun scripts/check-coverage.ts coverage/lcov.info --write-baseline",
    "coverage:promote": "bun scripts/check-coverage.ts coverage/lcov.info --promote-covered-sources",
    "ui:add": "bun scripts/ui-add.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "CI=1 playwright test",
    "test:db": "bash scripts/test-postgres-integration.sh",
    "test:sep:backend": "bun test --isolate packages/api/src/sep-admission/sep-capture.test.ts packages/api/src/sep-admission/sep-bundle-capture.test.ts packages/api/src/sep-admission/sep-capture-limits.test.ts packages/api/src/sep-admission/sep-structural-corpus.test.ts scripts/check-live-sep-structure.test.ts && bash scripts/test-postgres-integration.sh sep-production",
    "test:sep:frontend": "VITE_SERVER_URL=http://127.0.0.1:3000 bun test --isolate --no-env-file --preload ./happydom.ts apps/web/tests/routes/sources/admission.test.tsx apps/web/tests/routes/sources/reading-lifecycle.test.tsx apps/web/src/components/source-admission/preview.test.tsx apps/web/src/components/reading-workspace/reading-route-navigation.test.tsx apps/web/src/components/reading-workspace/reading-route-tools.test.tsx apps/web/src/components/reading-workspace/citation-resolution-panel.test.tsx apps/web/src/offline-working-set/offline-working-set-panel.test.tsx",
    "test:sep:database": "bun run test:db",
    "test:sep:browser": "VITE_SERVER_URL=http://127.0.0.1:3102 bun run --filter web build && E2E_PRODUCTION=1 playwright test tests/e2e/sep-production-gate.spec.ts",
    "test:sep:production": "bash scripts/test-sep-production-gate.sh",
    "test:sep:live": "bun scripts/check-live-sep-structure.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "quality": "biome lint --only=complexity/useMaxParams --only=style/noExcessiveLinesPerFile apps packages && bun run quality:fallow && bun run quality:architecture && bun run quality:props && bun run quality:bundle && bun run quality:docs",
    "quality:ci": "bun run check && bun run quality && bun run openapi:check && bun run test:coverage",
    "quality:architecture": "bun scripts/check-architecture.ts",
    "quality:fallow": "fallow health --baseline .fallow/baselines/health.json && fallow dupes --baseline .fallow/baselines/dupes.json && fallow dead-code --fail-on-regression --regression-baseline .fallow/baselines/dead-code.json",
    "quality:fallow:metric": "bun scripts/fallow-metric.ts",
    "quality:docs": "bun scripts/check-documentation.ts",
    "quality:policy": "scripts/test-quality-gate.sh",
    "quality:bundle": "bun test scripts/web-bundle-budget.test.ts && bun run --filter web build",
    "quality:props": "bun scripts/check-react-props.ts",
    "e2e:api": "bun scripts/e2e-api-substitute.ts",
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "openapi:check": "bun run scripts/generate-openapi.ts --check",
    "check:semgrep": "scripts/semgrep-scan.sh blocking",
    "report:semgrep": "scripts/semgrep-scan.sh report",
    "secrets:check": "scripts/secret-scan.sh history",
    "secrets:staged": "scripts/secret-scan.sh staged",
    "secrets:range": "scripts/secret-scan.sh range",
    "dependency:check": "bun scripts/verify-dependency-assessments.ts --staged",
    "dependency:score": "bun scripts/score-dependencies.ts",
    "maintenance:test": "scripts/test-maintenance-policy.sh",
    "security:trivy:config": "scripts/trivy-scan.sh config",
    "security:trivy:dependencies": "scripts/trivy-scan.sh dependencies",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "logs": "pino-pretty < logs/server.log",
    "db:push": "bun run --filter @lirna/db db:push",
    "db:studio": "bun run lifecycle allocate . --tool studio && bun run lifecycle run studio",
    "db:generate": "bun run --filter @lirna/db db:generate",
    "db:migrate": "bun run lifecycle database migrate",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "prepare": "husky"
  },
  "dependencies": {
    "@lirna/env": "workspace:*",
    "ai": "^7.0.73",
    "dotenv": "catalog:",
    "workflow": "^4.8.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@biomejs/biome": "^2.5.6",
    "@happy-dom/global-registrator": "^20.11.2",
    "@hughescr/stryker-bun-runner": "1.3.8",
    "@lirna/config": "workspace:*",
    "@playwright/test": "1.61.1",
    "@stryker-mutator/core": "9.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/bun": "catalog:",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "pino-pretty": "^13.1.3",
    "tinyglobby": "0.2.17",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome format --write"
    ]
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "@hughescr/stryker-bun-runner@1.3.8": "patches/@hughescr%2Fstryker-bun-runner@1.3.8.patch"
  }
}

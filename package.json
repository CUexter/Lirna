{
  "name": "lirna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:down": "docker compose down",
    "db:up": "docker compose up -d postgres",
    "dev": "concurrently -k -n api,worker \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "start:api": "node dist/entrypoints/api.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "test": "vitest run",
    "test:scenario": "vitest run tests/scenario/synthetic-operation.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.5.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.0",
    "playwright-core": "^1.54.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "lirna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p config/tsconfig.build.json",
    "check:persistence": "tsx server/database/check-persistence-access.ts",
    "dependency:add": "node scripts/assess-dependency.mjs",
    "dependency:run-scripts": "node scripts/run-dependency-scripts.mjs",
    "check:dependency-assessments": "node scripts/verify-dependency-assessments.mjs --staged",
    "check:semgrep": "scripts/semgrep-scan.sh blocking",
    "check:trivy": "scripts/trivy-npm-scan.sh",
    "db:down": "docker compose down",
    "db:generate": "tsx server/database/generate-migrations.ts",
    "db:migrate": "tsx server/database/migrate.ts",
    "db:up": "docker compose up -d postgres",
    "dev": "concurrently -k -n api,worker,client \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:api": "tsx watch server/entrypoints/api.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:worker": "tsx watch server/entrypoints/worker.ts",
    "check": "npm run check:biome && npm run typecheck && npm run test:unit && npm run build",
    "check:biome": "biome ci --config-path config/biome.json .",
    "format": "biome check --config-path config/biome.json --write .",
    "metrics": "npm run metrics:coverage && npm run metrics:health",
    "metrics:coverage": "vitest run --config config/vitest.config.ts --project unit --project integration --coverage",
    "metrics:health": "mkdir -p metrics && node scripts/normalize-istanbul-coverage.mjs coverage/coverage-final.json metrics/coverage-final.json && fallow health --coverage metrics/coverage-final.json --file-scores --hotspots --score --targets --report-only --format json --output-file metrics/health.json",
    "start:api": "node dist/entrypoints/api.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "test": "npm run check:persistence && vitest run --config config/vitest.config.ts",
    "test:unit": "vitest run --config config/vitest.config.ts --project unit",
    "test:integration": "vitest run --config config/vitest.config.ts --project integration",
    "test:dependency-assessments": "scripts/test-dependency-verification.sh",
    "test:secrets": "scripts/test-secret-scanning.sh",
    "test:security-scanning": "scripts/test-security-scanning.sh",
    "test:trivy-policy": "scripts/test-trivy-policy.sh",
    "test:e2e": "vitest run --config config/vitest.config.ts --project e2e",
    "test:browser": "playwright test --config config/playwright.config.ts --project=firefox",
    "test:gate": "vitest run --config config/vitest.config.ts --project gate",
    "typecheck": "tsc -p config/tsconfig.node.json --noEmit && tsc -p config/tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-beta.2-6565b14",
    "hono": "^4.13.1",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testcontainers/postgresql": "^11.5.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.0",
    "drizzle-kit": "1.0.0-beta.2-6565b14",
    "fallow": "3.15.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
